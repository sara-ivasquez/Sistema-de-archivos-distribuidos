# Copia este archivo como docker/.env y cambia los valores.
# Deben ser IGUALES en todos los nodos del cluster.

# Secreto compartido entre ControlNodes y DataNodes (endpoints internos,
# DELETE/REPLICATE de bloques). Genera uno con: openssl rand -hex 32
CLUSTER_SECRET=cambia-este-secreto

# Clave de cifrado en reposo de los bloques (AES-256-GCM).
DN_ENCRYPTION_KEY=cambia-esta-clave
