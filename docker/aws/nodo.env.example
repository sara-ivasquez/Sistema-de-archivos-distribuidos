# Copia como docker/aws/.env en CADA VM y ajusta lo que corresponda.

# ---- Igual en TODAS las VMs ----
CLUSTER_SECRET=cambia-este-secreto
DN_ENCRYPTION_KEY=cambia-esta-clave
BLOCK_SIZE=4194304
REPLICATION_FACTOR=2

# ---- Solo en las VMs de ControlNode ----
# VM ControlNode 1: CN_ROLE=primary  y CN_PEER_URL apuntando al ControlNode 2
# VM ControlNode 2: CN_ROLE=standby  y CN_PEER_URL apuntando al ControlNode 1
CN_ROLE=primary
CN_PEER_URL=https://IP_CN2:5000

# ---- Solo en las VMs de DataNode ----
DN_PUBLIC_HOST=IP_DE_ESTA_VM
DN_PORT=6001
DN_API_PORT=7001
CONTROLNODE_URLS=https://IP_CN1:5000,https://IP_CN2:5000
